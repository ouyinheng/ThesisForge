{
  "name": "paperblog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"yarn dev --port 5178\" \"wait-on http://localhost:5178 && ~/Library/Caches/electron/dist/Electron.app/Contents/MacOS/Electron --no-sandbox .\"",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "preview": "vite preview",
    "type:check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@iconify-json/line-md": "^1.2.16",
    "@tiptap/extension-code-block-lowlight": "^2.6.0",
    "@tiptap/extension-color": "^2.6.0",
    "@tiptap/extension-highlight": "^2.6.0",
    "@tiptap/extension-image": "^2.6.0",
    "@tiptap/extension-link": "^2.6.0",
    "@tiptap/extension-placeholder": "^2.6.0",
    "@tiptap/extension-table": "^2.6.0",
    "@tiptap/extension-table-cell": "^2.6.0",
    "@tiptap/extension-table-header": "^2.6.0",
    "@tiptap/extension-table-row": "^2.6.0",
    "@tiptap/extension-task-item": "^2.6.0",
    "@tiptap/extension-task-list": "^2.6.0",
    "@tiptap/extension-text-align": "^2.6.0",
    "@tiptap/extension-text-style": "^2.6.0",
    "@tiptap/extension-underline": "^2.6.0",
    "@tiptap/pm": "^2.6.0",
    "@tiptap/starter-kit": "^2.6.0",
    "@tiptap/vue-3": "^2.6.0",
    "@vicons/ionicons5": "^0.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lowlight": "^3.1.0",
    "naive-ui": "^2.44.1",
    "pinia": "^2.2.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vue": "^3.4.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.1.36",
    "@types/node": "^26.1.2",
    "@unocss/preset-attributify": "^0.61.0",
    "@unocss/preset-icons": "^0.61.0",
    "@unocss/preset-uno": "^0.61.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "less": "^4.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "5.5",
    "unocss": "^0.61.0",
    "vite": "5.4.11",
    "vue-tsc": "2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.paperblog.app",
    "productName": "PaperBlog",
    "icon": "electron/PaperBlog.icns",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
